{
  "xml.fileAssociations": [
    {
      "pattern": "fixtures/in/*.xml",
      "systemId": "schema/infrastructure/cda/CDA_SDTC.xsd"
    }
  ],
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  // A Turtle, SPARQL or XML file is left as written on save: a copied input
  // keeps its checksum and a Bridge's output is committed unedited (see
  // .editorconfig). JSON is not overridden: none of it is copied.
  "[xml]": {
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false
  },
  "[turtle]": {
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false
  },
  "[sparql]": {
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false
  }
}
