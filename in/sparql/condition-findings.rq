PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX void:   <http://rdfs.org/ns/void#>
PREFIX fx:     <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX v3:     <urn:hl7-org:v3>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX ccda:   <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# A status a problem states that the concept map condition.rq reads it through
# does not hold: its Problem Status Observation's, or, where it has none, its
# concern act's, each at the status's own code; the concern act's status where the
# problem states one no map holds, which is then read from nowhere; and the display
# name of a status observation's value, where the map does not hold its code or gives the code no such
# label, which nothing carries. And a code of its value with no code system, or a code
# system that is no OID, or no code, and a nullFlavor on its time or a bound of it that is no NullFlavor
# code, so no reason for the absent date is carried. And an absent reason of its
# value or a translation that no list defines, where no other code of it is
# carried: reported at the code that states it.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [ a oa:XPathSelector ; rdf:value ?refinement ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
  ?outer a v3:component ; ?bodySlot ?body .
  ?body a v3:structuredBody ; ?componentSlot ?component .
  ?component a v3:component ; ?sectionSlot ?section .
  ?section a v3:section ; ?entrySlot ?entry .
  ?entry a v3:entry ; ?actSlot ?act .
  ?act a v3:act .
  {
    ?act ?relationshipSlot ?relationship . ?relationship a v3:entryRelationship ; ?statementSlot ?condition .
    BIND (CONCAT(STRAFTER(STR(?relationshipSlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?innerSlots)
  }
  UNION
  {
    ?act ?statementSlot ?condition .
    BIND (STRAFTER(STR(?statementSlot), "#_") AS ?innerSlots)
  }
  ?condition a v3:observation .
  FILTER EXISTS {
    ?condition ?templateSlot ?template .
    ?template a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.4" .
  }
  FILTER EXISTS {
    ?act ?concernSlot ?concern .
    ?concern a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.3" .
  }
  BIND (CONCAT(
          STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
          STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
          STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?actSlot), "#_"), ".", ?innerSlots) AS ?slots)
  ?row ccda:statementAt ?slots ; ccda:refinement ?statementRefinement .
  BIND (EXISTS {
          ?condition ?anyS ?anyRelationship . ?anyRelationship a v3:entryRelationship ; ?anyO ?anyStatus .
          ?anyStatus a v3:observation ; ?anyT ?anyTemplate ; ?anyVS ?anyValue .
          ?anyTemplate a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.6" .
          ?anyValue a v3:value ; xyz:code ?anyCode .
        } AS ?statedStatus)
  {
    {
      ?condition ?rS ?statusRelationship . ?statusRelationship a v3:entryRelationship ; ?oS ?observation .
      ?observation a v3:observation ; ?otS ?ot ; ?ovS ?coded .
      ?ot a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.6" .
      ?coded a v3:value ; xyz:code ?value .
      OPTIONAL { ?coded xyz:codeSystem ?codeSystem }
      FILTER (COALESCE(REPLACE(?codeSystem, "^urn:oid:", ""), "") != "2.16.840.1.113883.6.96" || NOT EXISTS {
        ?concept skos:inScheme ccda:problemStatuses ; skos:notation ?key .
        FILTER (?key = LCASE(REPLACE(?value, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
      })
      BIND (ccda:problemStatusNotMapped AS ?gap)
    }
    {
      SELECT (?rankedStatusRelationship AS ?statusRelationship) (CONCAT("/*[local-name()='entryRelationship' and namespace-uri()='urn:hl7-org:v3'][", STR(COUNT(?earlierStatusRelationship)), "]") AS ?statusRelationshipStep) WHERE {
        ?statusRelationshipParent ?statusRelationshipS ?rankedStatusRelationship . ?rankedStatusRelationship a v3:entryRelationship .
        ?statusRelationshipParent ?statusRelationshipE ?earlierStatusRelationship . ?earlierStatusRelationship a v3:entryRelationship .
        FILTER (xsd:integer(STRAFTER(STR(?statusRelationshipE), "#_")) <= xsd:integer(STRAFTER(STR(?statusRelationshipS), "#_")))
      } GROUP BY ?rankedStatusRelationship
    }
    {
      SELECT (?rankedObservation AS ?observation) (CONCAT("/*[local-name()='observation' and namespace-uri()='urn:hl7-org:v3'][", STR(COUNT(?earlierObservation)), "]") AS ?observationStep) WHERE {
        ?observationParent ?observationS ?rankedObservation . ?rankedObservation a v3:observation .
        ?observationParent ?observationE ?earlierObservation . ?earlierObservation a v3:observation .
        FILTER (xsd:integer(STRAFTER(STR(?observationE), "#_")) <= xsd:integer(STRAFTER(STR(?observationS), "#_")))
      } GROUP BY ?rankedObservation
    }
    {
      # Once for the document, joined to each value by its key; document-table.rq says why.
      SELECT (?rankedValue AS ?coded) (COUNT(?earlierValue) AS ?valueAt) WHERE {
        ?valueParent ?valueS ?rankedValue . ?rankedValue a v3:value .
        ?valueParent ?valueE ?earlierValue . ?earlierValue a v3:value .
        FILTER (xsd:integer(STRAFTER(STR(?valueE), "#_")) <= xsd:integer(STRAFTER(STR(?valueS), "#_")))
      } GROUP BY ?rankedValue
    }
    BIND (CONCAT(?statusRelationshipStep, ?observationStep, "/*[local-name()='value' and namespace-uri()='urn:hl7-org:v3'][", STR(?valueAt), "]/@code") AS ?codedStep)
  }
  UNION
  {
    {
      ?condition ?rS ?statusRelationship . ?statusRelationship a v3:entryRelationship ; ?oS ?observation .
      ?observation a v3:observation ; ?otS ?ot ; ?ovS ?coded .
      ?ot a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.6" .
      ?coded a v3:value ; xyz:displayName ?value .
      OPTIONAL { ?coded xyz:code ?statedCode }
      OPTIONAL { ?coded xyz:codeSystem ?codeSystem }
      FILTER NOT EXISTS {
        ?concept skos:inScheme ccda:problemStatuses ; skos:notation ?key ; skos:prefLabel|skos:altLabel ?label .
        FILTER (?key = LCASE(REPLACE(?statedCode, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
        FILTER (REPLACE(?codeSystem, "^urn:oid:", "") = "2.16.840.1.113883.6.96")
        FILTER (LCASE(REPLACE(STR(?label), "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")) = LCASE(REPLACE(?value, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
      }
      BIND (ccda:observationValueDisplayNameNotCarried AS ?gap)
    }
    {
      SELECT (?rankedStatusRelationship AS ?statusRelationship) (CONCAT("/*[local-name()='entryRelationship' and namespace-uri()='urn:hl7-org:v3'][", STR(COUNT(?earlierStatusRelationship)), "]") AS ?statusRelationshipStep) WHERE {
        ?statusRelationshipParent ?statusRelationshipS ?rankedStatusRelationship . ?rankedStatusRelationship a v3:entryRelationship .
        ?statusRelationshipParent ?statusRelationshipE ?earlierStatusRelationship . ?earlierStatusRelationship a v3:entryRelationship .
        FILTER (xsd:integer(STRAFTER(STR(?statusRelationshipE), "#_")) <= xsd:integer(STRAFTER(STR(?statusRelationshipS), "#_")))
      } GROUP BY ?rankedStatusRelationship
    }
    {
      SELECT (?rankedObservation AS ?observation) (CONCAT("/*[local-name()='observation' and namespace-uri()='urn:hl7-org:v3'][", STR(COUNT(?earlierObservation)), "]") AS ?observationStep) WHERE {
        ?observationParent ?observationS ?rankedObservation . ?rankedObservation a v3:observation .
        ?observationParent ?observationE ?earlierObservation . ?earlierObservation a v3:observation .
        FILTER (xsd:integer(STRAFTER(STR(?observationE), "#_")) <= xsd:integer(STRAFTER(STR(?observationS), "#_")))
      } GROUP BY ?rankedObservation
    }
    {
      SELECT (?rankedValue AS ?coded) (COUNT(?earlierValue) AS ?valueAt) WHERE {
        ?valueParent ?valueS ?rankedValue . ?rankedValue a v3:value .
        ?valueParent ?valueE ?earlierValue . ?earlierValue a v3:value .
        FILTER (xsd:integer(STRAFTER(STR(?valueE), "#_")) <= xsd:integer(STRAFTER(STR(?valueS), "#_")))
      } GROUP BY ?rankedValue
    }
    BIND (CONCAT(?statusRelationshipStep, ?observationStep, "/*[local-name()='value' and namespace-uri()='urn:hl7-org:v3'][", STR(?valueAt), "]/@displayName") AS ?codedStep)
  }
  UNION
  {
    {
      ?act ?sS ?status . ?status a v3:statusCode ; xyz:code ?value .
      BIND (true AS ?atAct)
      FILTER NOT EXISTS {
        ?concept skos:inScheme ccda:concernStatuses ; skos:notation ?key .
        FILTER (?key = LCASE(REPLACE(?value, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
      }
      BIND (ccda:concernStatusNotMapped AS ?gap)
    }
    {
      SELECT (?rankedStatus AS ?status) (CONCAT("/*[local-name()='statusCode' and namespace-uri()='urn:hl7-org:v3'][", STR(COUNT(?earlierStatus)), "]/@code") AS ?codedStep) WHERE {
        ?statusParent ?statusS ?rankedStatus . ?rankedStatus a v3:statusCode .
        ?statusParent ?statusE ?earlierStatus . ?earlierStatus a v3:statusCode .
        FILTER (xsd:integer(STRAFTER(STR(?statusE), "#_")) <= xsd:integer(STRAFTER(STR(?statusS), "#_")))
      } GROUP BY ?rankedStatus
    }
  }
  UNION
  {
    {
      ?act ?sS ?status . ?status a v3:statusCode ; xyz:code ?value .
      { ?act ?stateRelationshipSlot ?stateRelationship . ?stateRelationship a v3:entryRelationship ; ?stateStatementSlot ?condition }
      UNION
      { ?act ?stateStatementSlot ?condition }
      ?condition a v3:observation .
      FILTER EXISTS {
        ?condition ?anyS ?anyRelationship . ?anyRelationship a v3:entryRelationship ; ?anyO ?anyStatus .
        ?anyStatus a v3:observation ; ?anyT ?anyTemplate ; ?anyVS ?anyValue .
        ?anyTemplate a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.6" .
        ?anyValue a v3:value ; xyz:code ?anyCode .
      }
      FILTER NOT EXISTS {
        ?condition ?mapS ?mapRelationship . ?mapRelationship a v3:entryRelationship ; ?mapO ?mapStatus .
        ?mapStatus a v3:observation ; ?mapT ?mapTemplate ; ?mapVS ?mapValue .
        ?mapTemplate a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.6" .
        ?mapValue a v3:value ; xyz:code ?mapCode ; xyz:codeSystem ?mapSystem .
        FILTER (REPLACE(?mapSystem, "^urn:oid:", "") = "2.16.840.1.113883.6.96")
        ?mapConcept skos:inScheme ccda:problemStatuses ; skos:notation ?mapKey .
        FILTER (?mapKey = LCASE(REPLACE(?mapCode, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
      }
      BIND (true AS ?atAct)
      BIND (ccda:concernStatusNotCarriedBesideUnmappedStatus AS ?gap)
    }
    {
      SELECT (?rankedStatus AS ?status) (CONCAT("/*[local-name()='statusCode' and namespace-uri()='urn:hl7-org:v3'][", STR(COUNT(?earlierStatus)), "]/@code") AS ?codedStep) WHERE {
        ?statusParent ?statusS ?rankedStatus . ?rankedStatus a v3:statusCode .
        ?statusParent ?statusE ?earlierStatus . ?earlierStatus a v3:statusCode .
        FILTER (xsd:integer(STRAFTER(STR(?statusE), "#_")) <= xsd:integer(STRAFTER(STR(?statusS), "#_")))
      } GROUP BY ?rankedStatus
    }
  }
  UNION
  {
    { ?condition ?vS ?coding . ?coding a v3:value }
    UNION
    { ?condition ?vS ?coded . ?coded a v3:value ; ?trS ?coding . ?coding a v3:translation }
    OPTIONAL { ?coding xyz:code ?statedCode }
    OPTIONAL { ?coding xyz:codeSystem ?statedSystem }
    FILTER (BOUND(?statedCode) || BOUND(?statedSystem))
    BIND (LCASE(REPLACE(REPLACE(?statedSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")) AS ?statedKey)
    FILTER (!BOUND(?statedCode) || !BOUND(?statedSystem) || !REGEX(?statedKey, "^[0-2](\\.(0|[1-9][0-9]*))+$") || REPLACE(?statedCode, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") = "")
    BIND (COALESCE(?statedSystem, ?statedCode) AS ?value)
    BIND (ccda:codeNotCarried AS ?gap)
  }
  UNION
  {
    ?condition ?flavourTimeSlot ?flavourTime . ?flavourTime a v3:effectiveTime .
    { ?flavourTime xyz:nullFlavor ?value }
    UNION
    { ?flavourTime ?flavourBoundSlot ?flavourBound . ?flavourBound a ?flavourBoundType ; xyz:nullFlavor ?value .
      VALUES ?flavourBoundType { v3:low v3:high } }
    FILTER NOT EXISTS {
      ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey .
      FILTER (?flavourKey = LCASE(REPLACE(?value, "^[ \t\r\n]+|[ \t\r\n]+$", "")))
    }
    BIND (ccda:nullFlavorNotListed AS ?gap)
  }
  UNION
  {
    ?condition ?flavourValueSlot ?flavourValue . ?flavourValue a v3:value ; xyz:nullFlavor ?value .
    FILTER NOT EXISTS {
      ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey .
      FILTER (?flavourKey = LCASE(REPLACE(?value, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
    }
    BIND (ccda:nullFlavorNotListed AS ?gap)
  }
  UNION
  {
    {
      { ?condition ?vS ?valueElement . ?valueElement a v3:value . BIND (?valueElement AS ?coding) }
      UNION
      { ?condition ?vS ?valueElement . ?valueElement a v3:value ; ?trS ?coding . ?coding a v3:translation }
      ?coding xyz:code ?statedAbsentReason ; xyz:codeSystem ?absentSystem .
      ?system skos:inScheme ccda:codeSystems ; skos:notation ?systemKey ; void:uriSpace ?stem .
      FILTER (?systemKey IN ("2.16.840.1.113883.5.1008", "2.16.840.1.113883.4.642.4.1048"))
      FILTER (?systemKey = LCASE(REPLACE(REPLACE(?absentSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")))
      BIND (REPLACE(?statedAbsentReason, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?value)
      FILTER (?value != "")
      BIND (IRI(CONCAT(?stem, ENCODE_FOR_URI(?value))) AS ?absentReason)
      FILTER NOT EXISTS { ?known skos:inScheme ccda:nullFlavors ; skos:exactMatch ?absentReason }
      FILTER NOT EXISTS { ?absentReason skos:inScheme ccda:dataAbsentReasons }
      FILTER NOT EXISTS {
        { ?condition ?otherS ?otherCoding . ?otherCoding a v3:value }
        UNION
        { ?condition ?otherS ?otherCoded . ?otherCoded a v3:value ; ?otherTrS ?otherCoding . ?otherCoding a v3:translation }
        ?otherCoding xyz:code ?otherCode ; xyz:codeSystem ?otherSystem .
        BIND (LCASE(REPLACE(REPLACE(?otherSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")) AS ?otherKey)
        FILTER (?otherKey NOT IN ("2.16.840.1.113883.5.1008", "2.16.840.1.113883.4.642.4.1048"))
        FILTER (REGEX(?otherKey, "^[0-2](\\.(0|[1-9][0-9]*))+$"))
        FILTER (REPLACE(?otherCode, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") != "")
      }
      BIND (ccda:absentReasonNotCarried AS ?gap)
    }
    {
      # Once for the document, joined to each value by its key; document-table.rq says why.
      SELECT (?rankedValue AS ?valueElement) (COUNT(?earlierValue) AS ?valueAt) WHERE {
        ?valueParent ?valueS ?rankedValue . ?rankedValue a v3:value .
        ?valueParent ?valueE ?earlierValue . ?earlierValue a v3:value .
        FILTER (xsd:integer(STRAFTER(STR(?valueE), "#_")) <= xsd:integer(STRAFTER(STR(?valueS), "#_")))
      } GROUP BY ?rankedValue
    }
    {
      SELECT (?rankedCoding AS ?coding) (COUNT(?earlierCoding) AS ?codingAt) WHERE {
        ?codingParent ?codingPS ?rankedCoding . ?rankedCoding a ?codingType .
        ?codingParent ?codingPE ?earlierCoding . ?earlierCoding a ?codingType .
        VALUES ?codingType { v3:value v3:translation }
        FILTER (xsd:integer(STRAFTER(STR(?codingPE), "#_")) <= xsd:integer(STRAFTER(STR(?codingPS), "#_")))
      } GROUP BY ?rankedCoding
    }
    BIND (CONCAT("/*[local-name()='value' and namespace-uri()='urn:hl7-org:v3'][", STR(?valueAt), "]",
                 IF(sameTerm(?coding, ?valueElement), "",
                    CONCAT("/*[local-name()='translation' and namespace-uri()='urn:hl7-org:v3'][", STR(?codingAt), "]")),
                 "/@code") AS ?codedStep)
  }
  FILTER (?gap != ccda:concernStatusNotMapped || !?statedStatus)
  BIND (CONCAT(IF(BOUND(?atAct),
                  CONCAT(STRBEFORE(?statementRefinement, "/*[local-name()='act' and namespace-uri()='urn:hl7-org:v3'][1]"),
                         "/*[local-name()='act' and namespace-uri()='urn:hl7-org:v3'][1]"),
                  ?statementRefinement),
               COALESCE(?codedStep, "")) AS ?refinement)
}
