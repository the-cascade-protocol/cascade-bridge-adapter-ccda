PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX fx:     <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX v3:     <urn:hl7-org:v3>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX ccda:   <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# The id an act states that wraps the statement a record is made from, as an
# Allergy Concern Act or a Problem Concern Act does, written as the record id of
# a statement is: root and extension, or whichever it states. The record takes
# the statement's id, so the act's is carried nowhere. One finding for each id,
# at the act, however many statements the act wraps. A Note Activity is its own
# statement and wraps none, and an act whose entry makes no record is the
# finding entryNotMapped, not this.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [ a oa:XPathSelector ; rdf:value ?refinement ]
    ] ;
    oa:hasBody ccda:concernActId ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  SELECT DISTINCT ?refinement ?value WHERE {
    ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
    ?outer a v3:component ; ?bodySlot ?body .
    ?body a v3:structuredBody ; ?componentSlot ?component .
    ?component a v3:component ; ?sectionSlot ?section .
    ?section a v3:section ; ?entrySlot ?entry .
    ?entry a v3:entry ; ?actSlot ?act .
    ?act a v3:act ; ?idSlot ?id .
    ?id a v3:id .
    OPTIONAL { ?id xyz:root ?idRoot }
    OPTIONAL { ?id xyz:extension ?idExtension }
    FILTER (BOUND(?idRoot) || BOUND(?idExtension))
    BIND (IF(BOUND(?idRoot) && BOUND(?idExtension), CONCAT(?idRoot, ":", ?idExtension), COALESCE(?idRoot, ?idExtension)) AS ?value)
    BIND (CONCAT(
            STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
            STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
            STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?actSlot), "#_"), ".") AS ?actSlots)
    {
      # Once for the document, joined to each act by its slots; document-table.rq says why.
      SELECT ?actSlots ?statementRefinement WHERE {
        ?row ccda:statementAt ?slots ; ccda:refinement ?statementRefinement .
        BIND (REPLACE(?slots, "^([^.]*[.][^.]*[.][^.]*[.][^.]*[.][^.]*[.][^.]*[.]).*$", "$1") AS ?actSlots)
      }
    }
    BIND (REPLACE(?statementRefinement, "^(.*/\\*\\[local-name\\(\\)='act' and namespace-uri\\(\\)='urn:hl7-org:v3'\\]\\[1\\]).*$", "$1") AS ?refinement)
  }
}
